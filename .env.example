# ==============================================================================
# MeetPulse AI — Environment Configuration Guide
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# 1. Canonical Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?pgbouncer=true"

# 3. LiveKit Cloud / WebRTC Video Engine (https://cloud.livekit.io)
# For local Docker testing: LIVEKIT_API_KEY=devkey, LIVEKIT_API_SECRET=secret, NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_WEBHOOK_SECRET=""

# 4. Deepgram Nova-2 Speech-to-Text & Diarization (https://console.deepgram.com)
DEEPGRAM_API_KEY=""

# 5. Anthropic Claude 3.5 Sonnet AI Extraction (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# 6. Resend Email Dispatch Service (https://resend.com)
RESEND_API_KEY=""

# 7. Meta WhatsApp Business Cloud API (https://developers.facebook.com)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# 8. Stripe SaaS Billing & Subscriptions (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

